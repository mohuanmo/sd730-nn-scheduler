#!/system/bin/sh
################################################################################
# SD730 Smart Scheduler - CLI Control Tool v1.5.4-nn (Neural Scheduler v2.1.4)
################################################################################

MODDIR="/data/adb/modules/sd730-scheduler"
. $MODDIR/common/functions.sh

show_help() {
    echo "SD730 Smart Scheduler v1.5.4-nn (NN v2.1.4)"
    echo ""
    echo "Usage: sd730-scheduler [OPTION]"
    echo ""
    echo "Options:"
    echo "  --mode <powersave|balanced|performance|ultra>"
    echo "      Switch to specified performance mode"
    echo "  --status"
    echo "      Show current status and statistics"
    echo "  --stats"
    echo "      Show learning database statistics"
    echo "  --prediction-stats"
    echo "      Show prediction database statistics"
    echo "  --reset-learning"
    echo "      Reset the learning database"
    echo "  --reset-prediction"
    echo "      Reset the prediction database"
    echo "  --mode-learning-stats"
    echo "      Show learned per-app mode preferences (from manual switches)"
    echo "  --reset-mode-learning"
    echo "      Reset the mode learning database"
    echo "  --prediction-enable"
    echo "      Enable the prediction engine"
    echo "  --prediction-disable"
    echo "      Disable the prediction engine"
    echo "  --daemon"
    echo "      Run as background daemon"
    echo "  --affinity <package>"
    echo "      Show recommended CPU affinity for an app"
    echo "  --threads [package]"
    echo "      Live per-thread CPU% and affinity mask of an app (default: foreground)"
    echo "  --gpu-status"
    echo "      GPU adaptive scheduler: lock/tier state, live nodes, watchdog health"
    echo "  --tpin-status"
    echo "      Thread Pin Engine status: pinned threads, elastic budget, learned names"
    echo "  --tpin-reset"
    echo "      Release all thread pins immediately (restores original masks)"
    echo "  --tpin-enable / --tpin-disable"
    echo "      Toggle the Thread Pin Engine (config/thread_pin.conf)"
    echo "  --selfm-reset"
    echo "      Reset self-management verdicts (apps re-observed from scratch)"
    echo "  --scene <mode>"
    echo "      Set mode via Scene integration"
    echo "  --nn-status"
    echo "      Neural Scheduler: model / data / alpha / last inference"
    echo "  --nn-train"
    echo "      Manually trigger model training (auto numpy|pure-python engine)"
    echo "  --nn-train-now [--v3]"
    echo "      FORCE training now: skips standby/data gates (temp: 85C hard ceiling)"
    echo "      --v3 -> force train thread-level v3 model (train_thread.py, needs numpy)"
    echo "  --nn-infer"
    echo "      Run one inference (prints: k cap_ratio)"
    echo "  --nn-test"
    echo "      Model integrity + inference sanity test"
    echo "  --nn-data"
    echo "      Data collector stats (rows, days, size, retention)"
    echo "  --nn-alpha <0.0-1.0>"
    echo "      Set NN mixing ratio (0=rule-only, 1=NN-only, suggest <=0.5)"
    echo "  --nn-enable / --nn-disable"
    echo "      Toggle the Neural Scheduler"
    echo "  --nn-warmup-test"
    echo "      Show foreground warmup detection state"
    echo "  --nn-v3-status"
    echo "      v3 thread-level model: config / model / live thread scores"
    echo "  --nn-thread-test"
    echo "      Run v3 inference on current state, show per-thread pin scores"
    echo "  --nn-v3-enable / --nn-v3-disable"
    echo "      Toggle v3 model-score thread reordering (config/v3.conf)"
    echo "  --help"
    echo "      Show this help message"
    echo ""
    echo "Scene Integration:"
    echo "  Write mode to: /data/adb/modules/sd730-scheduler/config/scene_mode"
    echo "  Values: auto, powersave, balanced, performance, ultra"
    echo ""
}

show_status() {
    local current=$(cat $CONFIG_DIR/current_mode 2>/dev/null || echo "balanced")
    local scene=$(cat $CONFIG_DIR/scene_mode 2>/dev/null || echo "auto")
    local temp=$(get_temperature)
    local battery=$(get_battery_level)
    local charging=$(get_battery_status)
    local fg_app=$(get_foreground_app)
    local gpu_load=$(get_gpu_load)

    echo "=== SD730 Smart Scheduler Status ==="
    echo "Mode: $current"
    echo "Scene Override: $scene"
    echo "Temperature: ${temp}C"
    echo "Battery: ${battery}% ($charging)"
    echo "Foreground App: $fg_app"
    echo "GPU Load: ${gpu_load}%"
    echo ""
    echo "=== CPU Frequencies ==="
    for cpu in $ALL_CORES; do
        local freq=$(cat $CPU_BASE/cpu$cpu/cpufreq/scaling_cur_freq 2>/dev/null)
        local gov=$(cat $CPU_BASE/cpu$cpu/cpufreq/scaling_governor 2>/dev/null)
        printf "cpu%d: %10s Hz [%s]\n" "$cpu" "$freq" "$gov"
    done
    echo ""
    echo "=== GPU Status ==="
    local gpu_cur=$(cat $GPU_CUR 2>/dev/null || echo "N/A")
    local gpu_gov=$(cat $GPU_GOVERNOR 2>/dev/null || echo "N/A")
    local gpu_min=$(cat $GPU_MIN 2>/dev/null || echo "N/A")
    local gpu_max=$(cat $GPU_MAX 2>/dev/null || echo "N/A")
    echo "GPU Freq: $gpu_cur"
    echo "GPU Governor: $gpu_gov"
    echo "GPU Limits: min=$gpu_min max=$gpu_max"
    if [ -f "$GPU_LOCK_STATE" ]; then
        local lk_tgt="" lk_min="" lk_state="" lk_rest=""
        IFS='|' read -r lk_tgt lk_min lk_state lk_rest < "$GPU_LOCK_STATE" 2>/dev/null
        case "$lk_tgt" in ''|*[!0-9]*) lk_tgt=0 ;; esac
        case "$lk_min" in ''|*[!0-9]*) lk_min=$lk_tgt ;; esac
        [ -z "$lk_state" ] && lk_state="locked"
        if [ "$lk_state" = "relaxed" ]; then
            echo "GPU Ultra Lock: RELAXED band $((lk_min / 1000000))-$((lk_tgt / 1000000))MHz (write-first watchdog; re-locks instantly on a hot thread)"
        else
            echo "GPU Ultra Lock: ACTIVE (pinned $((lk_tgt / 1000000))MHz, write-first watchdog)"
        fi
    else
        echo "GPU Ultra Lock: inactive"
    fi
    if [ -f "$GPU_APP_STATE" ]; then
        local ga_pkg="" ga_mode="" ga_tier="" ga_min="" ga_max="" ga_ts=""
        IFS='|' read -r ga_pkg ga_mode ga_tier ga_min ga_max ga_ts < "$GPU_APP_STATE" 2>/dev/null
        case "$ga_max" in ''|*[!0-9]*) ga_max=0 ;; esac
        case "$ga_min" in ''|*[!0-9]*) ga_min=0 ;; esac
        if [ "$ga_max" -gt 0 ] 2>/dev/null; then
            echo "GPU App Tier: $ga_tier ($ga_pkg, mode $ga_mode) -> band $((ga_min / 1000000))-$((ga_max / 1000000))MHz"
        else
            echo "GPU App Tier: $ga_tier ($ga_pkg, mode $ga_mode)"
        fi
    fi
    echo ""
    echo "=== Thread Pin Engine ==="
    tpin_load_conf
    echo "Enabled: $TP_ENABLED (modes: $TP_PIN_MODES)"
    if [ -f "$TPIN_STATE" ]; then
        local tp_pkg=$(awk -F'|' '$1=="PKG"{print $2}' "$TPIN_STATE" 2>/dev/null)
        local tp_exp=$(awk -F'|' '$1=="PKG"{print $4}' "$TPIN_STATE" 2>/dev/null)
        local tp_n=$(awk -F'|' -v m="$TP_BIG_MASK" '$1=="TID" && $10==m {n++} END{print n+0}' "$TPIN_STATE" 2>/dev/null)
        echo "Tracked app: $tp_pkg"
        echo "Pinned threads: $tp_n (elastic expanded: $tp_exp)"
    else
        echo "No active pins."
    fi
    echo ""
    if [ -n "$fg_app" ]; then
        local probs=$(get_app_probabilities "$fg_app")
        local big_prob=$(echo "$probs" | cut -d',' -f1)
        local little_prob=$(echo "$probs" | cut -d',' -f2)
        local gpu_prob=$(echo "$probs" | cut -d',' -f3)
        echo "=== App Learning Profile: $fg_app ==="
        echo "Big Core Affinity: ${big_prob}%"
        echo "LITTLE Core Affinity: ${little_prob}%"
        echo "GPU Affinity: ${gpu_prob}%"
    fi
    echo ""
    echo "=== Prediction Status ==="
    local pred_enabled=$(read_cfg "$PREDICTION_CONF" "prediction_enabled" "true")
    local last_pred=$(read_cfg "$PREDICTION_STATE" "last_predicted_app" "N/A")
    echo "Prediction Engine: $pred_enabled"
    echo "Last Predicted App: $last_pred"
    if [ -f "$PREDICTION_ACTIVE" ]; then
        local expiry=$(cut -d'|' -f1 "$PREDICTION_ACTIVE" 2>/dev/null)
        local now=$(date +%s)
        local remaining=$((expiry - now))
        [ "$remaining" -gt 0 ] 2>/dev/null && echo "Active Boost Remaining: ${remaining}s"
    fi
}

show_gpu_status() {
    gpu_sched_load_conf
    echo "=== Mode Resolution (why the GPU is where it is) ==="
    echo "Effective mode (.last_mode): $(cat "$CONFIG_DIR/.last_mode" 2>/dev/null || echo '?')"
    echo "Manual mode (current_mode):  $(cat "$CONFIG_DIR/current_mode" 2>/dev/null || echo '?')"
    echo "Scene base mode:             $(cat "$CONFIG_DIR/scene_mode" 2>/dev/null || echo '?')"
    if [ -f "$MODE_LEARN_STATE" ]; then
        echo "Learned per-app override:    $(cat "$MODE_LEARN_STATE" 2>/dev/null | cut -d'|' -f1-2 | tr '|' ' ')"
    else
        echo "Learned per-app override:    none"
    fi
    echo ""
    echo "=== GPU Adaptive Scheduler ==="
    echo "Enabled: $GPU_S_ENABLED"
    echo "Write-first interval: ${GPU_S_INTERVAL}s (ultra)"
    echo "Ultra relax floor: $((GPU_S_FLOOR_EFF / 1000000))MHz (configured $((GPU_S_FLOOR / 1000000))MHz, OPP-snapped)"
    echo "Important-scene threshold: thread >= ${GPU_S_IMPORTANT_CPU}% of one core"
    echo "Relax hysteresis: $GPU_S_RELAX_CYCLES quiet cycles (heavy profile x2, light x0.5)"
    echo "Tier gates: >=$GPU_S_HEAVY_PCT% heavy, >=$GPU_S_MID_PCT% mid (min $GPU_S_MIN_SAMPLES samples)"
    echo ""
    echo "=== Live GPU Nodes ==="
    echo "cur_freq: $(cat $GPU_CUR 2>/dev/null || echo N/A)"
    echo "min_freq: $(cat $GPU_MIN 2>/dev/null || echo N/A)  max_freq: $(cat $GPU_MAX 2>/dev/null || echo N/A)"
    echo "governor: $(cat $GPU_GOVERNOR 2>/dev/null || echo N/A)"
    echo "pwrlevel: min=$(cat $GPU_PATH/min_pwrlevel 2>/dev/null || echo N/A) max=$(cat $GPU_PATH/max_pwrlevel 2>/dev/null || echo N/A) thermal=$(cat $GPU_PATH/thermal_pwrlevel 2>/dev/null || echo N/A)"
    echo "OPP table: $(cat $GPU_PATH/devfreq/available_frequencies 2>/dev/null || echo N/A)"
    echo ""
    if [ -f "$GPU_LOCK_STATE" ]; then
        local lk_tgt="" lk_min="" lk_state="" lk_rest=""
        IFS='|' read -r lk_tgt lk_min lk_state lk_rest < "$GPU_LOCK_STATE" 2>/dev/null
        case "$lk_tgt" in ''|*[!0-9]*) lk_tgt=0 ;; esac
        case "$lk_min" in ''|*[!0-9]*) lk_min=$lk_tgt ;; esac
        [ -z "$lk_state" ] && lk_state="locked"
        echo "Ultra lock: $lk_state (min $((lk_min / 1000000))MHz, cap $((lk_tgt / 1000000))MHz)"
    else
        echo "Ultra lock: inactive"
    fi
    if [ -f "$GPU_APP_STATE" ]; then
        local ga_pkg="" ga_mode="" ga_tier="" ga_min="" ga_max="" ga_ts=""
        IFS='|' read -r ga_pkg ga_mode ga_tier ga_min ga_max ga_ts < "$GPU_APP_STATE" 2>/dev/null
        echo "App tier: $ga_tier ($ga_pkg, mode $ga_mode, band $((ga_min / 1000000))-$((ga_max / 1000000))MHz)"
    else
        echo "App tier: none published"
    fi
    local fg_app=$(get_foreground_app)
    if [ -n "$fg_app" ]; then
        echo "Foreground: $fg_app -> $(gpu_app_tier "$fg_app" | awk -F'|' '{printf "tier=%s gpu=%s%% samples=%s", $1, $2, $3}')"
    fi
    if [ -f "$GPU_WD_PID" ]; then
        local wdpid=$(cat "$GPU_WD_PID" 2>/dev/null)
        if [ -n "$wdpid" ] && [ -d "/proc/$wdpid" ]; then
            echo "Watchdog: running (pid $wdpid)"
        else
            echo "Watchdog: NOT running (stale pid ${wdpid:-none})"
        fi
    else
        echo "Watchdog: NOT running"
    fi
}

nn_cfg() {
    # 读取 nn.conf 配置 (独立于 functions.sh 的 NN_* 变量, 兼容未打补丁状态)
    local _f="$MODDIR/config/nn.conf"
    local _key="$1" _def="$2"
    local _v="$_def"
    if [ -f "$_f" ]; then
        _v=$(grep "^$_key=" "$_f" 2>/dev/null | cut -d'=' -f2-)
    fi
    case "$_v" in ''|*[!0-9.]*) _v="$_def" ;; esac
    echo "$_v"
}

show_nn_status() {
    local nn_enabled=$(nn_cfg nn_enabled "true")
    local nn_alpha=$(nn_cfg nn_alpha "0.0")
    local nn_temp_limit=$(nn_cfg nn_temp_limit "70")
    local keep_days=$(nn_cfg nn_data_keep_days "3")
    echo "=== Neural Scheduler Status ==="
    echo "Enabled: $nn_enabled"
    echo "Alpha (NN mix ratio): $nn_alpha   (0=rule-only)"
    echo "Temperature limit: ${nn_temp_limit}C (above -> force rule-only)"
    echo "Data retention: ${keep_days} days (collector auto-rotates)"
    echo "Train gate: deep-standby(charging+off+noFG), max temp $(nn_cfg nn_train_max_temp 55)C; --nn-train-now 强制: 跳过待机/样本门槛, 温度绝对上限 85C"
    echo ""
    echo "=== Model ==="
    if [ -f "$MODDIR/model/mlp_weights.txt" ]; then
        local hdr=$(head -1 "$MODDIR/model/mlp_weights.txt" 2>/dev/null)
        local mtime=$(stat -c %y "$MODDIR/model/mlp_weights.txt" 2>/dev/null | cut -d. -f1)
        echo "Model: EXISTS (architecture: $hdr)"
        echo "Last trained: $mtime"
    else
        echo "Model: MISSING (train with: sd730-scheduler --nn-train)"
    fi
    echo ""
    echo "=== Training Data ==="
    local total_rows=0 n_files=0 oldest="-" newest="-"
    for f in "$MODDIR"/data/collector/*.raw; do
        [ -f "$f" ] || continue
        n_files=$((n_files + 1))
        local rows=$(wc -l < "$f" 2>/dev/null)
        case "$rows" in ''|*[!0-9]*) rows=0 ;; esac
        total_rows=$((total_rows + rows))
        local d=$(basename "$f" .raw)
        [ "$oldest" = "-" ] && oldest=$d
        newest=$d
    done
    echo "Data files: $n_files (dates $oldest .. $newest)"
    echo "Total samples: $total_rows (need >=500 to train)"
    if [ "$total_rows" -ge 500 ] 2>/dev/null; then
        echo "Training readiness: READY"
    else
        echo "Training readiness: not enough data yet"
    fi
    echo ""
    echo "=== Live Inference ==="
    if [ -f "$MODDIR/bin/nn_infer.sh" ]; then
        local out=$(sh "$MODDIR/bin/nn_infer.sh" 2>/dev/null)
        [ -n "$out" ] && echo "nn_infer.sh -> $out  (k cap_ratio)" || echo "nn_infer.sh -> (no output)"
    else
        echo "nn_infer.sh missing"
    fi
}

nn_train() {
    if [ -f "$MODDIR/bin/train.sh" ]; then
        echo "[+] Triggering training (auto numpy|pure-python engine)..."
        sh "$MODDIR/bin/train.sh"
    elif [ -f "$MODDIR/train_pure.py" ] && command -v python3 >/dev/null 2>&1; then
        echo "[+] Fallback: pure-python engine directly"
        python3 -u "$MODDIR/train_pure.py"
    else
        echo "[-] train.sh not found and no python3. Nothing to do."
        return 1
    fi
}

nn_infer() {
    if [ -f "$MODDIR/bin/nn_infer.sh" ]; then
        sh "$MODDIR/bin/nn_infer.sh"
    else
        echo "[-] nn_infer.sh not found"
        return 1
    fi
}

nn_test() {
    echo "=== NN Model Test ==="
    local model="$MODDIR/model/mlp_weights.txt"
    if [ ! -f "$model" ]; then
        echo "[-] FAIL: model missing at $model"
        echo "    Run: sd730-scheduler --nn-train"
        return 1
    fi
    local hdr=$(head -1 "$model" 2>/dev/null)
    echo "[1] Model file: $model"
    echo "    Header: $hdr (expect: 10 16 2)"
    case "$hdr" in
        "10 16 2") echo "    ✓ architecture OK" ;;
        *) echo "    ✗ unexpected header"; return 1 ;;
    esac
    local lines=$(wc -l < "$model" 2>/dev/null)
    echo "    Lines: $lines (expect 29 = 1+10+1+16+1)"
    [ "$lines" -eq 29 ] 2>/dev/null && echo "    ✓ layout OK" || echo "    ✗ layout wrong"
    echo "[2] Live inference:"
    if [ -f "$MODDIR/bin/nn_infer.sh" ]; then
        local out=$(sh "$MODDIR/bin/nn_infer.sh" 2>/dev/null)
        local k=$(echo "$out" | awk '{print $1}')
        local cap=$(echo "$out" | awk '{print $2}')
        case "$k" in ''|*[!0-9.]*) k=0 ;; esac
        case "$cap" in ''|*[!0-9.]*) cap=0 ;; esac
        local k_ok=$(awk "BEGIN {print ($k >= 0.5 && $k <= 2.0) ? 1 : 0}" 2>/dev/null)
        local c_ok=$(awk "BEGIN {print ($cap >= 0.5 && $cap <= 1.5) ? 1 : 0}" 2>/dev/null)
        echo "    output: $out"
        [ "$k_ok" = "1" ] && echo "    ✓ k in [0.5, 2.0]" || echo "    ✗ k out of range"
        [ "$c_ok" = "1" ] && echo "    ✓ cap in [0.5, 1.5]" || echo "    ✗ cap out of range"
        if [ "$k_ok" = "1" ] && [ "$c_ok" = "1" ]; then
            echo ""
            echo "✓✓✓ MODEL TEST PASSED - inference pipeline healthy"
        else
            echo ""
            echo "✗ MODEL TEST FAILED - retrain with: sd730-scheduler --nn-train"
            return 1
        fi
    else
        echo "[-] nn_infer.sh missing"
        return 1
    fi
}

nn_data() {
    echo "=== Collector Data ==="
    local total_rows=0 n_files=0 total_bytes=0
    for f in "$MODDIR"/data/collector/*.raw; do
        [ -f "$f" ] || continue
        n_files=$((n_files + 1))
        local rows=$(wc -l < "$f" 2>/dev/null)
        case "$rows" in ''|*[!0-9]*) rows=0 ;; esac
        total_rows=$((total_rows + rows))
        local sz=$(wc -c < "$f" 2>/dev/null)
        case "$sz" in ''|*[!0-9]*) sz=0 ;; esac
        total_bytes=$((total_bytes + sz))
    done
    echo "Data files: $n_files"
    echo "Total rows: $total_rows"
    echo "Total size: $((total_bytes / 1024)) KB"
    echo "Retention:  $(nn_cfg nn_data_keep_days 3) days"
    if [ -f "$MODDIR/data/collector/.coll_state" ]; then
        echo "State snapshot: $(cat "$MODDIR/data/collector/.coll_state" 2>/dev/null)"
    fi
    local coll_pid=""
    coll_pid=$(pgrep -f "collector.sh" 2>/dev/null | head -1)
    if [ -n "$coll_pid" ]; then
        echo "Collector: RUNNING (pid $coll_pid)"
    else
        echo "Collector: not running (start: sh $MODDIR/bin/collector.sh &)"
    fi
}

nn_set_alpha() {
    local v="$1"
    case "$v" in
        ''|*[!0-9.]*) echo "Error: alpha must be a number (0.0 - 1.0)"; return 1 ;;
    esac
    local ok=$(awk "BEGIN {print ($v >= 0 && $v <= 1) ? 1 : 0}" 2>/dev/null)
    if [ "$ok" != "1" ]; then
        echo "Error: alpha out of range (0.0 - 1.0), suggest <= 0.5"
        return 1
    fi
    if [ -f "$MODDIR/config/nn.conf" ]; then
        sed -i "s/^nn_alpha=.*/nn_alpha=$v/" "$MODDIR/config/nn.conf"
        echo "[+] nn_alpha set to: $v"
    else
        echo "[-] nn.conf not found at $MODDIR/config/nn.conf"
        return 1
    fi
}

nn_toggle() {
    local val="$1"
    if [ -f "$MODDIR/config/nn.conf" ]; then
        sed -i "s/^nn_enabled=.*/nn_enabled=$val/" "$MODDIR/config/nn.conf"
        echo "[+] Neural Scheduler $([ "$val" = "true" ] && echo enabled || echo disabled)."
    else
        echo "[-] nn.conf not found"
        return 1
    fi
}

nn_v3_status() {
    echo "=== v3 Thread-Level Model Status ==="
    local v3_on="false"
    if [ -f "$MODDIR/config/v3.conf" ]; then
        v3_on=$(grep '^v3_enabled=' "$MODDIR/config/v3.conf" 2>/dev/null | cut -d'=' -f2-)
    fi
    echo "v3 reorder: $v3_on (config/v3.conf)"
    echo ""
    echo "=== v3 Model ==="
    if [ -f "$MODDIR/model/mlp_v3_enc.txt" ] && [ -f "$MODDIR/model/mlp_v3_scr.txt" ]; then
        echo "Model: EXISTS"
        echo "  encoder header: $(head -1 "$MODDIR/model/mlp_v3_enc.txt" | wc -w) cols x $(wc -l < "$MODDIR/model/mlp_v3_enc.txt") lines (expect 25x10 layout)"
        echo "  scorer lines: $(wc -l < "$MODDIR/model/mlp_v3_scr.txt") (expect 41)"
        echo "  last trained: $(stat -c %y "$MODDIR/model/mlp_v3_enc.txt" 2>/dev/null | cut -d. -f1)"
    else
        echo "Model: MISSING (train with: sd730-scheduler --nn-train-now --v3)"
    fi
    echo ""
    echo "=== v3 Training Data ==="
    local n_traw=0 rows=0
    for f in "$MODDIR"/data/collector/*.traw; do
        [ -f "$f" ] || continue
        n_traw=$((n_traw + 1))
        local r=$(wc -l < "$f" 2>/dev/null)
        case "$r" in ''|*[!0-9]*) r=0 ;; esac
        rows=$((rows + r))
    done
    echo "traw files: $n_traw, total rows: $rows (need >=300 to train)"
    if [ -f "$MODDIR/data/collector/.frame_stats" ]; then
        echo "last frame stats: $(cat "$MODDIR/data/collector/.frame_stats") (frames|avg_ms|var|zero_ratio)"
    else
        echo "frame stats: not available (collector v3 sampling?)"
    fi
    echo ""
    echo "=== Live Thread Scores ==="
    if [ -f "$MODDIR/model/mlp_v3_enc.txt" ]; then
        sh "$MODDIR/bin/v3_decision.sh" 2>/dev/null | head -8
    fi
}

nn_thread_test() {
    echo "=== v3 Thread Inference Test ==="
    if [ ! -f "$MODDIR/model/mlp_v3_enc.txt" ]; then
        echo "[-] v3 model missing. Train: sd730-scheduler --nn-train-now (train_thread.py)"
        return 1
    fi
    echo "Per-thread pin scores (tid|score|cpu, higher=more likely big):"
    sh "$MODDIR/bin/v3_decision.sh" 2>/dev/null | head -10
    echo ""
    echo "Raw model inference:"
    sh "$MODDIR/bin/nn_infer_v3.sh" 2>/dev/null
}

nn_v3_toggle() {
    local val="$1"
    if [ -f "$MODDIR/config/v3.conf" ]; then
        sed -i "s/^v3_enabled=.*/v3_enabled=$val/" "$MODDIR/config/v3.conf"
        echo "[+] v3 thread reordering $([ "$val" = "true" ] && echo enabled || echo disabled)."
    else
        echo "[-] v3.conf not found"
        return 1
    fi
}

nn_warmup_test() {
    echo "=== Warmup Detection ==="
    local fg="$MODDIR/data/collector/.fg_duration"
    if [ -f "$fg" ]; then
        local dur=$(cat "$fg" 2>/dev/null)
        case "$dur" in ''|*[!0-9]*) dur=999 ;; esac
        echo "Foreground duration: ${dur}s (warmup window: $(nn_cfg nn_warmup_seconds 3)s)"
        if [ "$dur" -lt "$(nn_cfg nn_warmup_seconds 3)" ] 2>/dev/null; then
            echo "Status: WARMUP ACTIVE (k boost +$(nn_cfg nn_warmup_k_boost 0.3))"
        else
            echo "Status: normal (no boost)"
        fi
    else
        echo "No foreground tracking yet (collector not running?)"
    fi
}

case "$1" in
    --mode)
        if [ -z "$2" ]; then
            echo "Error: No mode specified"
            echo "Valid modes: powersave, balanced, performance, ultra"
            exit 1
        fi
        case "$2" in
            powersave|balanced|performance|ultra)
                echo "$2" > "$CONFIG_DIR/current_mode"
                echo "[+] Mode switched to: $2"
                apply_mode "$2" "" "force"
                # Learn this MANUAL switch for the foreground app, and clear
                # any auto-applied learned mode: the user's hand always wins.
                fg_app=$(get_foreground_app)
                [ -n "$fg_app" ] && record_mode_switch "$fg_app" "$2" "user"
                rm -f "$MODE_LEARN_STATE" 2>/dev/null
                ;;
            *)
                echo "Error: Invalid mode '$2'"
                exit 1
                ;;
        esac
        ;;
    --status)
        show_status
        ;;
    --stats)
        get_learning_stats
        ;;
    --prediction-stats)
        get_prediction_stats
        ;;
    --reset-learning)
        reset_learning
        ;;
    --reset-prediction)
        reset_prediction
        ;;
    --mode-learning-stats)
        get_mode_learning_stats
        ;;
    --reset-mode-learning)
        reset_mode_learning
        ;;
    --prediction-enable)
        sed -i 's/^prediction_enabled=.*/prediction_enabled=true/' "$PREDICTION_CONF"
        echo "[+] Prediction engine enabled."
        ;;
    --prediction-disable)
        sed -i 's/^prediction_enabled=.*/prediction_enabled=false/' "$PREDICTION_CONF"
        echo "[+] Prediction engine disabled."
        ;;
    --daemon)
        # The child shell must source functions.sh itself: shell functions are
        # not inherited by "sh -c", so the old one-liner just spun forever on
        # "run_learning_cycle: not found".
        nohup sh -c ". '$MODDIR/common/functions.sh'; self_pin_little; aff_env_log; while true; do run_learning_cycle; sleep 5; done" > /dev/null 2>&1 &
        echo "[+] Daemon started."
        ;;
    --affinity)
        if [ -z "$2" ]; then
            echo "Error: No package specified"
            exit 1
        fi
        echo "Recommended CPU affinity for $2:"
        echo "  Powersave:   0x$(get_affinity_mask "$2" "powersave")"
        echo "  Balanced:    0x$(get_affinity_mask "$2" "balanced")"
        echo "  Performance: 0x$(get_affinity_mask "$2" "performance")"
        echo "  Ultra:       0x$(get_affinity_mask "$2" "ultra")"
        ;;
    --threads)
        show_thread_top "$2"
        ;;
    --gpu-status)
        show_gpu_status
        ;;
    --tpin-status)
        get_tpin_status
        ;;
    --tpin-reset)
        reset_tpin
        ;;
    --tpin-enable)
        tpin_write_default_conf
        sed -i 's/^thread_pin_enabled=.*/thread_pin_enabled=true/' "$TPIN_CONF"
        echo "[+] Thread Pin Engine enabled."
        ;;
    --selfm-reset)
        reset_selfmanage
        ;;
    --tpin-disable)
        tpin_write_default_conf
        sed -i 's/^thread_pin_enabled=.*/thread_pin_enabled=false/' "$TPIN_CONF"
        release_all_pins "ff" "engine disabled"
        tcorr_release_all "engine disabled"
        rm -f "$SELFM_STATE" 2>/dev/null
        echo "[+] Thread Pin Engine disabled, all pins released."
        ;;
    --nn-status)
        show_nn_status
        ;;
    --nn-train)
        nn_train
        ;;
    --nn-train-now)
        # 主动判断后立即强制训练 (v3.1.1): 跳过 待机/样本量 门槛; 温度仅保留 85°C 绝对上限
        if [ -f "$MODDIR/bin/train.sh" ]; then
            if [ "$2" = "--v3" ]; then
                echo "[+] FORCE v3 training now (train_thread.py --force)..."
                sh "$MODDIR/bin/train.sh" --force --v3
            else
                echo "[+] FORCE training now (skips standby/data gates)..."
                sh "$MODDIR/bin/train.sh" --force
            fi
        else
            echo "[-] train.sh not found"
        fi
        ;;
    --nn-infer)
        nn_infer
        ;;
    --nn-test)
        nn_test
        ;;
    --nn-data)
        nn_data
        ;;
    --nn-alpha)
        if [ -z "$2" ]; then
            echo "Error: No alpha specified (0.0 - 1.0)"
            exit 1
        fi
        nn_set_alpha "$2"
        ;;
    --nn-enable)
        nn_toggle true
        ;;
    --nn-disable)
        nn_toggle false
        ;;
    --nn-warmup-test)
        nn_warmup_test
        ;;
    --nn-v3-status)
        nn_v3_status
        ;;
    --nn-thread-test)
        nn_thread_test
        ;;
    --nn-v3-enable)
        nn_v3_toggle true
        ;;
    --nn-v3-disable)
        nn_v3_toggle false
        ;;
    --scene)
        if [ -z "$2" ]; then
            echo "Error: No mode specified"
            echo "Valid values: auto, powersave, balanced, performance, ultra"
            exit 1
        fi
        case "$2" in
            auto|powersave|balanced|performance|ultra)
                echo "$2" > "$CONFIG_DIR/scene_mode"
                echo "[+] Scene mode set to: $2"
                ;;
            *)
                echo "Error: Invalid scene mode '$2'"
                echo "Valid values: auto, powersave, balanced, performance, ultra"
                exit 1
                ;;
        esac
        ;;
    --help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown option: $1"
        show_help
        exit 1
        ;;
esac
